{
  "id": "default-novel-workflow",
  "name": "长篇小说生产线工作流",
  "version": "0.9.0",
  "global_inputs": [
    {
      "key": "title",
      "label": "项目标题",
      "type": "text",
      "required": true,
      "default": "雾港旧声",
      "help": "",
      "options": []
    },
    {
      "key": "theme",
      "label": "主题偏好",
      "type": "textarea",
      "required": false,
      "default": "悬疑、记忆、旧港、群像",
      "help": "",
      "options": []
    },
    {
      "key": "target_length",
      "label": "目标规模",
      "type": "select",
      "required": false,
      "default": "长篇",
      "help": "",
      "options": [
        "短篇",
        "中篇",
        "长篇"
      ]
    }
  ],
  "provider_profiles": [
    {
      "id": "mock-text",
      "name": "演示文本模型",
      "kind": "mock",
      "base_url": "",
      "api_key_env": "",
