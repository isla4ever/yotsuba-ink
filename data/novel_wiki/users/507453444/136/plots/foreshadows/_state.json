      "updated_at": "2026-05-22T15:56:41Z"
    },
    {
      "id": "c3fb93a31749",
      "text": "但切断脐带需要一把‘钥匙’——一个能同时连接胚胎和腔体的活体接口。",
      "status": "open",
      "first_volume": 2,
      "first_chapter": 5,
      "first_title": "码头回声",
      "mentions": 1,
      "history": [
        {
          "volume": 2,
          "chapter_no": 5,
          "title": "码头回声",
          "event": "touch",
          "text": "但切断脐带需要一把‘钥匙’——一个能同时连接胚胎和腔体的活体接口。",
          "updated_at": "2026-05-22T15:56:41Z"
        }
      ],
      "created_at": "2026-05-22T15:56:41Z",
      "last_volume": 2,
