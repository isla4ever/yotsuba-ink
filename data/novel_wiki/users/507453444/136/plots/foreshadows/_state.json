    },
    {
      "id": "2eb1e90dc14b",
      "text": "雾港市档案馆坐落在旧城区边缘，一栋灰白色的四层建筑，外墙爬满了干枯的藤蔓。",
      "status": "partially_resolved",
      "first_volume": 1,
      "first_chapter": 1,
      "first_title": "回声档案",
      "mentions": 2,
      "history": [
        {
          "volume": 1,
          "chapter_no": 1,
          "title": "回声档案",
          "event": "touch",
          "text": "雾港市档案馆坐落在旧城区边缘，一栋灰白色的四层建筑，外墙爬满了干枯的藤蔓。",
          "updated_at": "2026-05-22T15:51:36Z"
        }
