    {
      "id": "df1a06ec6e47",
      "text": "林渡川没有急着去触碰那份证据，而是先顺着现场遗留的痕迹，将周围重新审视了一遍。",
      "status": "open",
      "first_volume": null,
      "first_chapter": 2,
      "first_title": "都分不旧案",
      "mentions": 2,
      "history": [
        {
          "volume": null,
          "chapter_no": 2,
          "title": "都分不旧案",
          "event": "touch",
          "text": "林渡川没有急着去触碰那份证据，而是先顺着现场遗留的痕迹，将周围重新审视了一遍。",
          "updated_at": "2026-05-09T04:37:56Z"
        }
      ],
      "created_at": "2026-05-09T04:37:56Z",
      "last_volume": null,
      "last_chapter": 3,
