      "updated_at": "2026-05-09T04:47:58Z"
    },
    {
      "id": "d0565ac5574a",
      "text": "” 两人对视良久，空气中仿佛有电流窜动。",
      "status": "open",
      "first_volume": null,
      "first_chapter": 3,
      "first_title": "l陆意深林既白",
      "mentions": 1,
      "history": [
