    },
    {
      "id": "92a176448707",
      "text": "至于烧……林姑娘，你确定你能烧掉所有真相吗。",
      "status": "open",
      "first_volume": null,
      "first_chapter": 3,
      "first_title": "l陆意深林既白",
      "mentions": 1,
      "history": [
        {
          "volume": null,
          "chapter_no": 3,
          "title": "l陆意深林既白",
          "event": "touch",
          "text": "至于烧……林姑娘，你确定你能烧掉所有真相吗。",
          "updated_at": "2026-05-09T04:47:58Z"
        }
      ],
      "created_at": "2026-05-09T04:47:58Z",
      "last_volume": null,
      "last_chapter": 3,
      "last_title": "l陆意深林既白",
      "updated_at": "2026-05-09T04:47:58Z"
    },
    {
      "id": "97786c83aff8",
      "text": "她伸手捏起那卷文书的一角，指尖传来的触感冰凉刺骨，纸张纤维间似乎还残留着某种特殊的药味——那是云崖医馆特有的安神草混合着某种剧毒的气息。",
      "status": "open",
      "first_volume": null,
      "first_chapter": 3,
