    {
      "id": "c98322e0eabb",
      "text": "他看起来有些狼狈，但眼神却异常锐利。",
      "status": "open",
      "first_volume": null,
      "first_chapter": 2,
      "first_title": "不是普通旧案",
      "mentions": 2,
      "history": [
