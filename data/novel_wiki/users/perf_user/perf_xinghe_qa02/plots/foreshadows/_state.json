      "updated_at": "2026-05-09T06:21:22Z"
    },
    {
      "id": "80f77ac75371",
      "text": "也正因为他知道这一步不能错，心里那点隐约的不对劲才越发清晰。",
      "status": "partially_resolved",
      "first_volume": null,
      "first_chapter": 1,
      "first_title": "异常记录失录",
      "mentions": 3,
      "history": [
        {
          "volume": null,
          "chapter_no": 1,
          "title": "异常记录失录",
          "event": "touch",
          "text": "也正因为他知道这一步不能错，心里那点隐约的不对劲才越发清晰。",
          "updated_at": "2026-05-09T06:18:01Z"
        }
      ],
      "created_at": "2026-05-09T06:18:01Z",
      "last_volume": null,
